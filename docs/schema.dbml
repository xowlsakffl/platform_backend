Ref: notices.updated_by_staff_id > account_staffs.id
Ref: faqs.created_by_staff_id > account_staffs.id
Ref: faqs.updated_by_staff_id > account_staffs.id
Ref: hospital_feature_assignments.hospital_id > hospitals.id
Ref: hospital_feature_assignments.hospital_feature_id > hospital_features.id
Ref: chats.created_by_user_id > account_users.id
Ref: chat_participants.chat_id > chats.id
Ref: chat_participants.account_user_id > account_users.id
Ref: chat_messages.chat_id > chats.id
Ref: chat_messages.sender_user_id > account_users.id
Ref: chat_messages.reply_to_message_id > chat_messages.id
Ref: notification_deliveries.notification_inbox_id > notification_inboxes.id
Ref: monitored_scheduled_task_log_items.monitored_scheduled_task_id > monitored_scheduled_tasks.id
