Ref: beauty_business_registrations.beauty_id > beauties.id
Ref: hospital_business_registrations.hospital_id > hospitals.id
Ref: hospital_doctors.hospital_id > hospitals.id
Ref: beauty_experts.beauty_id > beauties.id
