Project medi_backend {
  database_type: 'MySQL'
  Note: '현재 Flyway V1~V13 기준. 실행 기준은 src/main/resources/db/migration이다.'
}

Table auth_sessions {
  id varchar(36) [pk]
  actor_type varchar(20) [not null]
  account_id bigint [not null]
  refresh_token_hash char(64) [not null, unique]
  previous_refresh_token_hash char(64)
  previous_token_valid_until timestamp
  persistent boolean [not null, default: false]
  expires_at timestamp [not null]
  last_used_at timestamp [not null]
  revoked_at timestamp
  revocation_reason varchar(80)
  ip_address varchar(45)
  user_agent varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (actor_type, account_id, revoked_at, expires_at)
    expires_at
    revoked_at
  }

  Note: 'Actor 공통 다형 인증 세션. account_id는 actor_type에 따라 계정 테이블을 가리키므로 물리 FK를 두지 않는다.'
}

Table password_reset_tokens {
  id bigint [pk, increment]
  actor_type varchar(20) [not null]
  email varchar(255) [not null]
  token_hash char(64) [not null]
  issued_at timestamp [not null]
  expires_at timestamp [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (actor_type, email) [unique]
    expires_at
  }

  Note: 'Actor 공통 비밀번호 재설정 토큰. 원문은 저장하지 않는다.'
}

Table account_staffs {
  id bigint [pk, increment]
  name varchar(255) [not null]
  nickname varchar(255) [not null, unique]
  email varchar(255) [not null, unique]
  phone varchar(50)
  email_verified_at timestamp
  password varchar(255) [not null]
  department varchar(100)
  job_title varchar(100)
  status varchar(20) [not null, default: 'ACTIVE']
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table staff_roles {
  id bigint [pk, increment]
  name varchar(100) [not null, unique]
  display_name varchar(100) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table staff_permissions {
  id bigint [pk, increment]
  code varchar(120) [not null, unique]
  display_name varchar(120) [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table staff_role_permissions {
  id bigint [pk, increment]
  staff_role_id bigint [not null]
  staff_permission_id bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (staff_role_id, staff_permission_id) [unique]
  }
}

Table account_staff_roles {
  id bigint [pk, increment]
  account_staff_id bigint [not null]
  staff_role_id bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (account_staff_id, staff_role_id) [unique]
  }
}

Table account_partners {
  id bigint [pk, increment]
  partner_id bigint [not null, unique]
  name varchar(255) [not null]
  nickname varchar(255) [not null, unique]
  email varchar(255) [not null, unique]
  phone varchar(50)
  email_verified_at timestamp
  password varchar(255) [not null]
  status varchar(255) [not null, default: 'SUSPENDED']
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table account_beauties {
  id bigint [pk, increment]
  beauty_id bigint [unique]
  name varchar(255) [not null]
  nickname varchar(255) [not null, unique]
  email varchar(255) [not null, unique]
  phone varchar(50)
  email_verified_at timestamp
  password varchar(255) [not null]
  status varchar(20) [not null, default: 'SUSPENDED']
  last_login_at timestamp
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table account_users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  nickname varchar(255) [not null, unique]
  email varchar(255) [not null, unique]
  phone varchar(50)
  signup_channel varchar(30) [not null, default: 'EMAIL']
  email_verified_at timestamp
  password varchar(255) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  warning_count int [not null, default: 0]
  blocked_at timestamp
  withdrawal_reason varchar(500)
  comment_notification_enabled boolean [not null, default: true]
  note_notification_enabled boolean [not null, default: true]
  marketing_sms_agreed boolean [not null, default: false]
  marketing_email_agreed boolean [not null, default: false]
  marketing_push_agreed boolean [not null, default: false]
  marketing_night_push_agreed boolean [not null, default: false]
  last_login_at timestamp
  last_accessed_at timestamp
  last_access_ip varchar(45)
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table partners {
  id bigint [pk, increment]
  name varchar(255) [not null, unique]
  description text
  instagram_link varchar(500)
  kakao_link varchar(500)
  road_address varchar(255)
  jibun_address varchar(255)
  latitude varchar(50)
  longitude varchar(50)
  operating_hours_notice text
  operation_hours json
  direction text
  view_count bigint [not null, default: 0]
  evaluation_count int [not null, default: 0]
  evaluation_average_rating decimal(2,1) [not null, default: 0.0]
  allow_status varchar(20) [not null, default: 'PENDING']
  status varchar(20) [not null, default: 'ACTIVE']
  assigned_staff_id bigint
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table partner_contacts {
  id bigint [pk, increment]
  partner_id bigint [not null]
  contact_type varchar(40) [not null]
  value varchar(255) [not null]
  sort_order tinyint [not null, default: 0]
  is_primary boolean [not null, default: false]
  is_active boolean [not null, default: true]
  verified_at timestamp
  memo varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table partner_business_registrations {
  id bigint [pk, increment]
  partner_id bigint [not null]
  business_number varchar(20) [not null, unique]
  company_name varchar(255) [not null]
  ceo_name varchar(100) [not null]
  business_type varchar(100)
  business_item varchar(100)
  business_address varchar(255)
  business_address_detail varchar(255)
  settlement_bank_name varchar(50)
  settlement_account_number varchar(50)
  settlement_account_holder varchar(100)
  tax_invoice_email varchar(255)
  issued_at date
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table partner_features {
  id bigint [pk, increment]
  code varchar(100) [not null, unique]
  name varchar(100) [not null]
  sort_order int [not null, default: 0]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table partner_feature_assignments {
  id bigint [pk, increment]
  partner_id bigint [not null]
  partner_feature_id bigint [not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (partner_id, partner_feature_id) [unique]
  }
}

Table partner_specialists {
  id bigint [pk, increment]
  partner_id bigint [not null]
  sort_order int [not null, default: 0]
  name varchar(255) [not null]
  gender varchar(20)
  position varchar(50)
  career_started_at date
  license_number varchar(100) [not null, unique]
  specialist_field varchar(80) [not null]
  educations json
  careers json
  etc_contents json
  status varchar(20) [not null, default: 'HIDDEN']
  allow_status varchar(20) [not null, default: 'PENDING']
  view_count bigint [not null, default: 0]
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table categories {
  id bigint [pk, increment]
  domain varchar(40) [not null]
  parent_id bigint
  depth tinyint [not null]
  group_code varchar(30)
  name varchar(120) [not null]
  code varchar(80)
  full_path varchar(255)
  sort_order int [not null, default: 0]
  status varchar(20) [not null, default: 'ACTIVE']
  is_menu_visible boolean [not null, default: true]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (domain, code) [unique]
  }
}

Table category_assignments {
  id bigint [pk, increment]
  categorizable_type varchar(191) [not null]
  categorizable_id bigint [not null]
  category_id bigint [not null]
  is_primary boolean [not null, default: false]
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    (categorizable_type, categorizable_id, category_id) [unique]
  }
}

Table media {
  id bigint [pk, increment]
  owner_type varchar(50) [not null]
  owner_id bigint [not null]
  collection varchar(50) [not null]
  disk varchar(20) [not null, default: 'LOCAL']
  path varchar(512) [not null, unique]
  original_name varchar(255) [not null]
  mime_type varchar(127) [not null]
  size bigint [not null]
  width int
  height int
  sort_order int [not null, default: 0]
  is_primary boolean [not null, default: false]
  metadata json
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp
}

Table operation_histories {
  id bigint [pk, increment]
  target_type varchar(80) [not null]
  target_id bigint [not null]
  actor_type varchar(20) [not null, default: 'STAFF']
  actor_id bigint
  action varchar(60) [not null]
  reason varchar(500)
  memo varchar(500)
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table operation_history_changes {
  id bigint [pk, increment]
  operation_history_id bigint [not null]
  field_key varchar(80) [not null]
  before_value text
  after_value text
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Ref: staff_role_permissions.staff_role_id > staff_roles.id [delete: cascade]
Ref: staff_role_permissions.staff_permission_id > staff_permissions.id [delete: cascade]
Ref: account_staff_roles.account_staff_id > account_staffs.id [delete: cascade]
Ref: account_staff_roles.staff_role_id > staff_roles.id [delete: cascade]
Ref: account_partners.partner_id > partners.id [delete: cascade]
Ref: partners.assigned_staff_id > account_staffs.id [delete: set null]
Ref: partner_contacts.partner_id > partners.id [delete: cascade]
Ref: partner_business_registrations.partner_id > partners.id [delete: cascade]
Ref: partner_feature_assignments.partner_id > partners.id [delete: cascade]
Ref: partner_feature_assignments.partner_feature_id > partner_features.id [delete: restrict]
Ref: partner_specialists.partner_id > partners.id [delete: cascade]
Ref: categories.parent_id > categories.id
Ref: category_assignments.category_id > categories.id [delete: restrict]
Ref: operation_history_changes.operation_history_id > operation_histories.id [delete: cascade]
