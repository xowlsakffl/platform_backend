Ref: hospital_videos.allowed_by_staff_id > account_staffs.id
Ref: hashtaggables.hashtag_id > hashtags.id
Ref: categories.parent_id > categories.id
Ref: category_assignments.category_id > categories.id
Ref: category_usages.category_id > categories.id
Ref: talks.author_id > account_users.id
Ref: talk_comments.talk_id > talks.id
Ref: talk_comments.parent_id > talk_comments.id
Ref: talk_comments.author_id > account_users.id
