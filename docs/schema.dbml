Ref: operation_history_changes.operation_history_id > operation_histories.id
Ref: talk_polls.talk_id > talks.id
Ref: talk_poll_options.talk_poll_id > talk_polls.id
Ref: talk_poll_votes.talk_poll_id > talk_polls.id
Ref: talk_poll_votes.talk_poll_option_id > talk_poll_options.id
Ref: talk_poll_votes.user_id > account_users.id
Ref: hospital_reviews.author_id > account_users.id
Ref: hospital_reviews.hospital_id > hospitals.id
Ref: hospital_reviews.doctor_id > hospital_doctors.id
Ref: hospital_review_comments.hospital_review_id > hospital_reviews.id
Ref: hospital_review_comments.parent_id > hospital_review_comments.id
Ref: hospital_review_comments.author_id > account_users.id
Ref: hospital_review_comment_mentions.hospital_review_comment_id > hospital_review_comments.id
Ref: hospital_review_comment_mentions.mentioned_user_id > account_users.id
Ref: hospital_review_comment_mentions.mentioned_by_user_id > account_users.id
Ref: hospital_evaluations.author_id > account_users.id
Ref: hospital_evaluations.hospital_id > hospitals.id
Ref: hospital_evaluations.doctor_id > hospital_doctors.id
Ref: content_reports.reporter_user_id > account_users.id
Ref: content_reports.target_author_id > account_users.id
Ref: content_report_items.content_report_id > content_reports.id
Ref: content_report_items.reporter_user_id > account_users.id
Ref: content_report_items.target_author_id > account_users.id
