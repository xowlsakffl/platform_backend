// Nullable logical FK/index references not always declared as database constraints
Ref: sessions.user_id > account_users.id
Ref: chat_participants.last_read_message_id > chat_messages.id
Ref: chat_participants.deleted_until_message_id > chat_messages.id
Ref: chats.last_message_id > chat_messages.id
